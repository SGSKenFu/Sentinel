# Application
NODE_ENV=development
PORT=3000
APP_NAME=sentinel

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=sentinel
DB_PASSWORD=sentinel_pass
DB_DATABASE=sentinel_db
DB_SYNCHRONIZE=true
# WARNING: Set to false in production! Use TypeORM migrations instead.
DB_LOGGING=false

# OpenSearch
OPENSEARCH_NODE=http://localhost:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=admin
OPENSEARCH_INDEX_INTELLIGENCE=sentinel-intelligence
OPENSEARCH_SSL_VERIFY=false

# JWT
JWT_SECRET=CHANGE_ME_GENERATE_RANDOM_64_CHAR_HEX_eg_openssl_rand_hex_32
JWT_EXPIRES_IN=7d

# LLM (OpenAI-compatible)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.2

# Notification - Email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@example.com
SMTP_PASS=smtp_password
SMTP_FROM=Sentinel <no-reply@example.com>

# Notification - Feishu
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your-token

# Notification - WeChat Work
WECHAT_WORK_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your-key

# Scheduler
INGESTION_CRON=0 */4 * * *
ENRICHMENT_CRON=*/15 * * * *

# Rate limiting
HTTP_TIMEOUT_MS=30000
HTTP_RETRY_ATTEMPTS=3
HTTP_RETRY_DELAY_MS=1000

# Tenant (default)
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
